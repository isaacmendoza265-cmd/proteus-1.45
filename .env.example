# GEMINI_API_KEY: clave de Google Gemini (obligatoria para las funciones de IA).
# En Google AI Studio se inyecta automáticamente desde el panel "Secrets".
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: URL donde se publica la app (AI Studio la inyecta en Cloud Run).
APP_URL="MY_APP_URL"

# PORT: puerto del servidor local (por defecto 3000).
PORT=3000

# DATABASE_URL: PostgreSQL (usuarios, perfil del candidato, piezas y archivos guardados). Obligatoria.
# En local, p. ej. un Postgres propio: postgresql://usuario:clave@localhost:5432/proteus
# Crear las tablas: npx prisma migrate deploy (en producción lo hace el contenedor al arrancar).
DATABASE_URL="postgresql://usuario:clave@localhost:5432/proteus"

# JWT_SECRET: firma de las sesiones. Obligatoria, mínimo 32 caracteres aleatorios.
# Generar: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="cambia-esto-por-48-bytes-aleatorios-en-base64url"

# ADMIN_EMAIL / ADMIN_CLAVE: primer administrador. Solo se usan si la base aún no tiene usuarios;
# después se gestionan en Ajustes › Usuarios y acceso.
ADMIN_EMAIL="admin@ejemplo.com"
ADMIN_CLAVE="una-clave-larga"

# TEST_DATABASE_URL: base DESECHABLE para las pruebas de integración (npm test). Sin ella se omiten.
# TEST_DATABASE_URL="postgresql://usuario:clave@localhost:5432/proteus_test"

# GOBERNACION_DIR: carpeta del Proyecto Independencia (base SQLite e informes).
# GOBERNACION_DIR="C:\\Users\\isaac\\OneDrive\\Documentos\\Poryecto independencia"

# PYTHON_PATH: ejecutable de Python para el bridge de Gobernación (opcional).
# PYTHON_PATH="python"
